{
  "name": "omarchy-website",
  "version": "1.0.0",
  "private": true,
  "description": "omarchy.org rebooted as a Commodore 64: a single-page WebGL site",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "dev": "node build/build.mjs --watch --serve",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:build",
    "test:unit": "node --test 'test/unit/**/*.test.js'",
    "test:build": "node --test 'test/build/**/*.test.js'",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run test && npm run build && npm run test:e2e"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "wrangler": "4.129.0"
  }
}
